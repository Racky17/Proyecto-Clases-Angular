# ---- Servidor ----
PORT=3000

# ---- Base de datos MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=acme

# ---- Seguridad (JWT) ----
# Cambia este valor por una cadena secreta larga y aleatoria.
JWT_SECRET=acme-secret-key-cambiar-en-produccion

# ---- Login con Google (OAuth) ----
# OAuth Client ID de Google. Debe ser el MISMO que googleClientId del frontend.
# Déjalo vacío si no usas el login con Google.
GOOGLE_CLIENT_ID=
